<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="서버 연결 테스트"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/config_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp" />

            <!-- 1. health -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="① HTTPS 연결 (GET /health)"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_health"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="220dp"
                android:text="health 확인"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/health_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="아직 확인하지 않았습니다."
                android:textSize="16sp" />

            <!-- 2. 아이 모드 대화 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="② 아이 모드 대화 (POST /agent/child)"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/child_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="아이가 할 말 (예: 사과는 영어로 뭐야?)"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLength="300"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_send"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:minWidth="120dp"
                    android:text="보내기"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/child_reply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#E5F0F6"
                android:minHeight="64dp"
                android:padding="12dp"
                android:text="테미의 답변이 여기에 나옵니다."
                android:textColor="#18384A"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/child_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp" />

            <!-- 3. 명령 채널 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="③ 명령 채널 (wss /ws/temi)"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/channel_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btn_reconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="다시 연결"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="최근 명령 (최대 20개, 최신이 위)"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/command_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="받은 명령이 없습니다."
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 개발 패널은 붙이지 않음 (입력창·답변을 가림). emulator의 Fake speak는 Logcat FakeRobot으로 확인 -->

</androidx.constraintlayout.widget.ConstraintLayout>
